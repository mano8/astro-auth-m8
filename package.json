{
  "name": "@mano8/astro-auth-m8",
  "version": "2.4.1",
  "description": "Astro integration and headless client for fa-auth-m8.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mano8/astro-auth-m8.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "auth",
    "fa-auth-m8"
  ],
  "files": [
    "dist",
    "src/routes",
    "src/scaffold/styles",
    "registry.json",
    "registry/r",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "astro-auth-m8": "dist/bin/astro-auth-m8.js"
  },
  "exports": {
    ".": "./dist/src/integration.js",
    "./api": "./dist/src/runtime/api/index.js",
    "./authorization": "./dist/src/runtime/authorization.js",
    "./client": "./dist/src/runtime/client.js",
    "./browser-adapter": "./dist/src/runtime/browserAdapter.js",
    "./schemas": "./dist/src/runtime/schemas.js",
    "./errors": "./dist/src/runtime/errors.js",
    "./hooks": "./dist/src/runtime/hooks/index.js",
    "./list-params": "./dist/src/runtime/listParams.js",
    "./react": "./dist/src/runtime/react/index.js",
    "./default-ui": "./dist/src/runtime/react/default-ui/index.js",
    "./routes": "./dist/src/runtime/routes.js",
    "./routes/login.astro": "./src/routes/login.astro",
    "./routes/signup.astro": "./src/routes/signup.astro",
    "./routes/logout.astro": "./src/routes/logout.astro",
    "./routes/callback.astro": "./src/routes/callback.astro",
    "./routes/account.astro": "./src/routes/account.astro",
    "./middleware": "./dist/src/middleware.js",
    "./compatibility": "./dist/src/runtime/compatibility.js"
  },
  "types": "./dist/src/integration.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:registry",
    "build:registry": "node scripts/build-registry.mjs",
    "preview:dev": "vite --config fixtures/preview/vite.config.ts",
    "preview:build": "tsc -p fixtures/preview/tsconfig.json --noEmit && vite build --config fixtures/preview/vite.config.ts",
    "verify:fleet-gates": "node scripts/verify-fleet-gates.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "verify:registry-drift": "node scripts/verify-registry-drift.mjs",
    "verify:starter-routes": "node scripts/verify-starter-routes.mjs",
    "verify:tarball-install": "node scripts/verify-tarball-install.mjs",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mano8/astro-ui-m8": "^1.5.1"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.3",
    "@tanstack/react-query": "^5.102.8",
    "astro": "^7.0.9",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.10",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "^7.2.9",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "faAuthM8": {
    "contract": "fa-auth-m8@2.0",
    "testedServiceVersion": "2.0.0",
    "serviceVersionRange": ">=2.0.0 <3.0.0"
  }
}
